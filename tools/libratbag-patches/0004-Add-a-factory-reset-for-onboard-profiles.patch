diff --git a/doc/dbus.rst b/doc/dbus.rst
index 97ba66d..711925a 100644
--- a/doc/dbus.rst
+++ b/doc/dbus.rst
@@ -185,6 +185,15 @@ known to ratbagd.
         occurs, the :func:`Resync` signal is emitted and all properties are
         updated to the current state.
 
+.. function:: FactoryReset() → (u)
+
+        Restores the onboard profiles of the device to the factory defaults
+        and discards all pending changes. Unlike :func:`Commit()` this call
+        is synchronous and may take a few seconds; the return value is the
+        libratbag error code (0 on success, or the capability error when the
+        device does not support a reset). The :func:`Resync` signal is
+        emitted afterwards and all properties are updated to the new state.
+
 .. function:: Resync()
 
         :type: Signal
diff --git a/ratbagd/ratbagd-device.c b/ratbagd/ratbagd-device.c
index 8d14f0a..cc957d4 100644
--- a/ratbagd/ratbagd-device.c
+++ b/ratbagd/ratbagd-device.c
@@ -206,6 +206,30 @@ static void ratbagd_device_commit_pending(void *data)
 	ratbagd_device_unref(device);
 }
 
+static int ratbagd_device_factory_reset(sd_bus_message *m,
+					void *userdata,
+					sd_bus_error *error)
+{
+	struct ratbagd_device *device = userdata;
+	int r;
+
+	/* Unlike Commit this runs synchronously so the caller learns whether
+	 * the device accepted the reset. Clients must use a generous timeout. */
+	r = ratbag_device_factory_reset(device->lib_device);
+	if (r)
+		log_error("error restoring the factory profiles (%d)\n", r);
+
+	/* the profiles changed completely, make every client re-read them */
+	ratbagd_device_resync(device, device->ctx->bus);
+	ratbagd_for_each_profile_signal(device->ctx->bus,
+					device,
+					ratbagd_profile_notify_dirty);
+
+	CHECK_CALL(sd_bus_reply_method_return(m, "u", r));
+
+	return 0;
+}
+
 static int ratbagd_device_commit(sd_bus_message *m,
 				 void *userdata,
 				 sd_bus_error *error)
@@ -271,6 +295,7 @@ const sd_bus_vtable ratbagd_device_vtable[] = {
 	SD_BUS_PROPERTY("FirmwareVersion", "s", ratbagd_device_get_firmware_version, 0, SD_BUS_VTABLE_PROPERTY_CONST),
 	SD_BUS_PROPERTY("Profiles", "ao", ratbagd_device_get_profiles, 0, SD_BUS_VTABLE_PROPERTY_CONST),
 	SD_BUS_METHOD("Commit", "", "u", ratbagd_device_commit, SD_BUS_VTABLE_UNPRIVILEGED),
+	SD_BUS_METHOD("FactoryReset", "", "u", ratbagd_device_factory_reset, SD_BUS_VTABLE_UNPRIVILEGED),
 	SD_BUS_SIGNAL("Resync", "", 0),
 	SD_BUS_VTABLE_END,
 };
diff --git a/src/driver-hidpp20.c b/src/driver-hidpp20.c
index b1677da..1db57e2 100644
--- a/src/driver-hidpp20.c
+++ b/src/driver-hidpp20.c
@@ -1668,6 +1668,29 @@ hidpp20drv_commit(struct ratbag_device *device)
 	return RATBAG_SUCCESS;
 }
 
+static int
+hidpp20drv_factory_reset(struct ratbag_device *device)
+{
+	struct hidpp20drv_data *drv_data = ratbag_get_drv_data(device);
+	struct ratbag_profile *profile;
+	int rc;
+
+	if (!(drv_data->capabilities & HIDPP_CAP_ONBOARD_PROFILES_8100))
+		return -ENOTSUP;
+
+	rc = hidpp20_onboard_profiles_factory_reset(drv_data->dev, drv_data->profiles);
+	if (rc < 0) {
+		log_error(device->ratbag,
+			  "hidpp20: failed to restore the factory profiles (%d)\n", rc);
+		return rc;
+	}
+
+	ratbag_device_for_each_profile(device, profile)
+		hidpp20drv_read_profile(profile);
+
+	return 0;
+}
+
 static int
 hidpp20drv_20_probe(struct ratbag_device *device)
 {
@@ -1857,5 +1880,6 @@ struct ratbag_driver hidpp20_driver = {
 	.probe = hidpp20drv_probe,
 	.remove = hidpp20drv_remove,
 	.commit = hidpp20drv_commit,
+	.factory_reset = hidpp20drv_factory_reset,
 	.set_active_profile = hidpp20drv_set_current_profile,
 };
diff --git a/src/hidpp20.c b/src/hidpp20.c
index 6442bb8..834e72c 100644
--- a/src/hidpp20.c
+++ b/src/hidpp20.c
@@ -3501,6 +3501,48 @@ hidpp20_onboard_profiles_commit(struct hidpp20_device *device,
 	return hidpp20_onboard_profiles_write_dict(device, profiles_list);
 }
 
+int
+hidpp20_onboard_profiles_factory_reset(struct hidpp20_device *device,
+				       struct hidpp20_profiles *profiles_list)
+{
+	struct hidpp20_profile *profile;
+	unsigned int i;
+	int rc;
+
+	/* Load the ROM profiles into the user slots, the same way a device
+	 * without a valid profile directory is read. */
+	for (i = 0; i < profiles_list->num_profiles; i++) {
+		profile = &profiles_list->profiles[i];
+
+		if (i + 1 > profiles_list->num_rom_profiles)
+			profile->address = HIDPP20_ROM_PROFILES_G402 + 1;
+		else
+			profile->address = HIDPP20_ROM_PROFILES_G402 + i + 1;
+		profile->enabled = i < profiles_list->num_rom_profiles;
+
+		rc = hidpp20_onboard_profiles_parse_profile(device, profiles_list, i, false);
+		if (rc < 0) {
+			hidpp_log_error(&device->base,
+					"failed to read ROM profile %u (%d)\n", i, rc);
+			return rc;
+		}
+	}
+
+	/* Write them back as regular user profiles with a valid directory,
+	 * exactly like a normal commit does. */
+	rc = hidpp20_onboard_profiles_commit(device, profiles_list);
+	if (rc < 0)
+		return rc;
+
+	rc = hidpp20_onboard_profiles_set_current_profile(device, 0);
+	if (rc < 0)
+		return rc;
+	profiles_list->active_profile_index = 0;
+
+	/* and pick up what the device actually stored */
+	return hidpp20_onboard_profiles_initialize(device, profiles_list);
+}
