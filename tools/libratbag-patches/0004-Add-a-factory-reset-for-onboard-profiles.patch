 				struct hidpp20_profiles *profiles_list);
 
+/**
+ * Restore the factory profiles: every user profile is replaced by the
+ * ROM profile the device shipped with, only as many profiles as the device
+ * has ROM profiles are enabled and the first profile is made the current
+ * one. The profile list is re-read from the device afterwards.
+ *
+ * return 0 or a negative error.
+ */
+int
+hidpp20_onboard_profiles_factory_reset(struct hidpp20_device *device,
+				       struct hidpp20_profiles *profiles_list);
+
