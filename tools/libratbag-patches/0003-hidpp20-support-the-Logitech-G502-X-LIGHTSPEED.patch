+/* -------------------------------------------------------------------------- */
+/* 0x2202: Extended Adjustable DPI                                            */
+/* -------------------------------------------------------------------------- */
+
+#define CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_COUNT		0x00
+#define CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_CAPABILITIES	0x10
+#define CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_DPI_RANGES	0x20
+#define CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_DPI_PARAMETERS	0x50
+#define CMD_EXT_ADJUSTABLE_DPI_SET_SENSOR_DPI_PARAMETERS	0x60
+
+#define HIDPP20_EXT_ADJUSTABLE_DPI_DIRECTION_X		0x00
+
+/* Each getSensorDpiRanges() reply carries 13 payload bytes after the
+ * 3 byte header (sensor index, direction, range index). */
+#define HIDPP20_EXT_ADJUSTABLE_DPI_RANGE_PAYLOAD	13
+#define HIDPP20_EXT_ADJUSTABLE_DPI_MAX_RANGE_REPLIES	16
+
+bool
+hidpp20_sensor_accepts_dpi(const struct hidpp20_sensor *sensor, uint16_t dpi)
+{
+	unsigned int i;
+
+	if (dpi < sensor->dpi_min || dpi > sensor->dpi_max)
+		return false;
+
+	if (sensor->num_dpi_ranges) {
+		for (i = 0; i < sensor->num_dpi_ranges; i++) {
+			const struct hidpp20_sensor_dpi_range *r = &sensor->dpi_ranges[i];
+
+			if (dpi < r->first || dpi > r->last)
+				continue;
+			if (r->step == 0 || (dpi - r->first) % r->step == 0)
+				return true;
+		}
+		return false;
+	}
+
+	if (sensor->dpi_steps)
+		return (dpi - sensor->dpi_min) % sensor->dpi_steps == 0;
+
+	for (i = 0; i < ARRAY_LENGTH(sensor->dpi_list) && sensor->dpi_list[i]; i++) {
+		if (sensor->dpi_list[i] == dpi)
+			return true;
+	}
+
+	return false;
+}
+
+static int
+hidpp20_ext_adjustable_dpi_get_count(struct hidpp20_device *device, uint8_t reg)
+{
+	int rc;
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_SHORT,
+		.msg.device_idx = device->index,
+		.msg.sub_id = reg,
+		.msg.address = CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_COUNT,
+	};
+
+	rc = hidpp20_request_command(device, &msg);
+	if (rc)
+		return rc;
+
+	return msg.msg.parameters[0];
+}
+
+static int
+hidpp20_ext_adjustable_dpi_get_capabilities(struct hidpp20_device *device,
+					    uint8_t reg,
+					    struct hidpp20_sensor *sensor)
+{
+	int rc;
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_SHORT,
+		.msg.device_idx = device->index,
+		.msg.sub_id = reg,
+		.msg.address = CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_CAPABILITIES,
+		.msg.parameters[0] = sensor->index,
+	};
+
+	rc = hidpp20_request_command(device, &msg);
+	if (rc)
+		return rc;
+
+	/* parameters[1] is the number of DPI levels, unused here */
+	sensor->ext_capabilities = msg.msg.parameters[2];
+
+	return 0;
+}
+
+static int
+hidpp20_sensor_add_dpi_range(struct hidpp20_device *device,
+			     struct hidpp20_sensor *sensor,
+			     uint16_t first, uint16_t last, uint16_t step)
+{
+	struct hidpp20_sensor_dpi_range *range;
+
+	if (sensor->num_dpi_ranges >= ARRAY_LENGTH(sensor->dpi_ranges)) {
+		hidpp_log_error(&device->base,
+				"0x2202: too many DPI ranges on sensor %d\n",
+				sensor->index);
+		return -EPROTO;
+	}
+
+	range = &sensor->dpi_ranges[sensor->num_dpi_ranges++];
+	range->first = first;
+	range->last = last;
+	range->step = step;
+
+	return 0;
+}
+
+/**
+ * The device answers getSensorDpiRanges() with a stream of big endian u16
+ * values spread over several replies, 13 payload bytes per reply. Plain
+ * values are DPIs, a value >= 0xe000 is a step size which applies from the
+ * preceding DPI up to the following one. A zero terminates the stream.
+ *
+ * Example (G502 X LIGHTSPEED): 100 step1 200 step2 500 step5 1000 ... 44000 0
+ */
+static int
+hidpp20_ext_adjustable_dpi_get_dpi_ranges(struct hidpp20_device *device,
+					  uint8_t reg,
+					  struct hidpp20_sensor *sensor)
+{
+	uint8_t stream[HIDPP20_EXT_ADJUSTABLE_DPI_MAX_RANGE_REPLIES *
+		       HIDPP20_EXT_ADJUSTABLE_DPI_RANGE_PAYLOAD];
+	size_t len = 0, pos;
+	uint8_t range_index;
+	uint16_t previous = 0, step = 0;
+	bool terminated = false;
+	bool have_previous = false, previous_covered = false;
+	int rc;
+
+	for (range_index = 0;
+	     range_index < HIDPP20_EXT_ADJUSTABLE_DPI_MAX_RANGE_REPLIES && !terminated;
+	     range_index++) {
+		union hidpp20_message msg = {
+			.msg.report_id = REPORT_ID_LONG,
+			.msg.device_idx = device->index,
+			.msg.sub_id = reg,
+			.msg.address = CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_DPI_RANGES,
+			.msg.parameters[0] = sensor->index,
+			.msg.parameters[1] = HIDPP20_EXT_ADJUSTABLE_DPI_DIRECTION_X,
+			.msg.parameters[2] = range_index,
+		};
+
+		rc = hidpp20_request_command(device, &msg);
+		if (rc)
+			return rc;
+
+		memcpy(stream + len, &msg.msg.parameters[3],
+		       HIDPP20_EXT_ADJUSTABLE_DPI_RANGE_PAYLOAD);
+		len += HIDPP20_EXT_ADJUSTABLE_DPI_RANGE_PAYLOAD;
+
+		/* a terminating zero somewhere in the stream so far? */
+		for (pos = 0; pos + 1 < len; pos += 2) {
+			if (get_unaligned_be_u16(&stream[pos]) == 0) {
+				terminated = true;
+				break;
+			}
+		}
+	}
+
+	if (!terminated) {
+		hidpp_log_error(&device->base,
+				"0x2202: DPI range list of sensor %d is not terminated\n",
+				sensor->index);
+		return -EPROTO;
+	}
+
+	sensor->dpi_min = 0xffff;
+	sensor->dpi_max = 0;
+	sensor->dpi_steps = 0;
+	sensor->num_dpi_ranges = 0;
+
+	for (pos = 0; pos + 1 < len; pos += 2) {
+		uint16_t value = get_unaligned_be_u16(&stream[pos]);
+
+		if (value == 0)
+			break;
+
+		if (value >= 0xe000) {
+			step = value - 0xe000;
+			continue;
+		}
+
+		if (step && have_previous && previous < value) {
+			/* previous ... value in steps of 'step' */
+			rc = hidpp20_sensor_add_dpi_range(device, sensor, previous, value, step);
+			if (rc)
+				return rc;
+			previous_covered = true;
+		} else {
+			/* a plain value not followed by a step is a discrete DPI */
+			if (have_previous && !previous_covered) {
+				rc = hidpp20_sensor_add_dpi_range(device, sensor, previous, previous, 0);
+				if (rc)
+					return rc;
+			}
+			previous_covered = false;
+		}
+
+		sensor->dpi_min = min(value, sensor->dpi_min);
+		sensor->dpi_max = max(value, sensor->dpi_max);
+		previous = value;
+		have_previous = true;
+		step = 0;
+	}
+
+	if (have_previous && !previous_covered) {
+		rc = hidpp20_sensor_add_dpi_range(device, sensor, previous, previous, 0);
+		if (rc)
+			return rc;
+	}
+
+	if (sensor->dpi_max == 0) {
+		hidpp_log_error(&device->base,
+				"0x2202: sensor %d reports no DPI values\n",
+				sensor->index);
+		return -EPROTO;
+	}
+
+	return 0;
+}
+
+static int
+hidpp20_ext_adjustable_dpi_get_dpi(struct hidpp20_device *device,
+				   uint8_t reg,
+				   struct hidpp20_sensor *sensor)
+{
+	int rc;
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_SHORT,
+		.msg.device_idx = device->index,
+		.msg.sub_id = reg,
+		.msg.address = CMD_EXT_ADJUSTABLE_DPI_GET_SENSOR_DPI_PARAMETERS,
+		.msg.parameters[0] = sensor->index,
+	};
+
+	rc = hidpp20_request_command(device, &msg);
+	if (rc)
+		return rc;
+
+	/* [1..2] dpi X, [3..4] default dpi X, [5..6] dpi Y,
+	 * [7..8] default dpi Y, [9] lift off distance */
+	sensor->dpi = get_unaligned_be_u16(&msg.msg.parameters[1]);
+	sensor->default_dpi = get_unaligned_be_u16(&msg.msg.parameters[3]);
+	sensor->lod = msg.msg.parameters[9];
+
+	return 0;
+}
+
+int hidpp20_ext_adjustable_dpi_get_sensors(struct hidpp20_device *device,
+					   struct hidpp20_sensor **sensors_list)
+{
+	uint8_t feature_index;
+	struct hidpp20_sensor *s_list, *sensor;
+	uint8_t num_sensors;
+	unsigned i;
+	int rc;
+
+	feature_index = hidpp_root_get_feature_idx(device,
+						   HIDPP_PAGE_EXTENDED_ADJUSTABLE_DPI);
+	if (feature_index == 0)
+		return -ENOTSUP;
+
+	rc = hidpp20_ext_adjustable_dpi_get_count(device, feature_index);
+	if (rc < 0)
+		return rc;
+
+	num_sensors = rc;
+	if (num_sensors == 0) {
+		*sensors_list = NULL;
+		return 0;
+	}
+
+	s_list = zalloc(num_sensors * sizeof(struct hidpp20_sensor));
+
+	for (i = 0; i < num_sensors; i++) {
+		sensor = &s_list[i];
+		sensor->index = i;
+
+		rc = hidpp20_ext_adjustable_dpi_get_capabilities(device,
+								 feature_index,
+								 sensor);
+		if (rc)
+			goto err;
+
+		rc = hidpp20_ext_adjustable_dpi_get_dpi_ranges(device,
+							       feature_index,
+							       sensor);
+		if (rc)
+			goto err;
+
+		rc = hidpp20_ext_adjustable_dpi_get_dpi(device, feature_index, sensor);
+		if (rc)
+			goto err;
+
+		hidpp_log_raw(&device->base,
+			      "sensor %d: current dpi: %d (default: %d) min: %d max: %d ranges: %d caps: 0x%02x\n",
+			      sensor->index,
+			      sensor->dpi,
+			      sensor->default_dpi,
+			      sensor->dpi_min,
+			      sensor->dpi_max,
+			      sensor->num_dpi_ranges,
+			      sensor->ext_capabilities);
+	}
+
+	*sensors_list = s_list;
+	return num_sensors;
+err:
+	free(s_list);
+	return rc > 0 ? -EPROTO : rc;
+}
+
+int hidpp20_ext_adjustable_dpi_set_sensor_dpi(struct hidpp20_device *device,
+					      struct hidpp20_sensor *sensor,
+					      uint16_t dpi)
+{
+	uint8_t feature_index;
+	int rc;
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_LONG,
+		.msg.device_idx = device->index,
+		.msg.address = CMD_EXT_ADJUSTABLE_DPI_SET_SENSOR_DPI_PARAMETERS,
+		.msg.parameters[0] = sensor->index,
+	};
+
+	feature_index = hidpp_root_get_feature_idx(device,
+						   HIDPP_PAGE_EXTENDED_ADJUSTABLE_DPI);
+	if (feature_index == 0)
+		return -ENOTSUP;
+
+	msg.msg.sub_id = feature_index;
+
+	/* [1..2] dpi X, [3..4] dpi Y, [5] lift off distance */
+	set_unaligned_be_u16(&msg.msg.parameters[1], dpi);
+	if (sensor->ext_capabilities & HIDPP20_EXT_ADJUSTABLE_DPI_CAP_Y)
+		set_unaligned_be_u16(&msg.msg.parameters[3], dpi);
+	if (sensor->ext_capabilities & HIDPP20_EXT_ADJUSTABLE_DPI_CAP_LOD)
+		msg.msg.parameters[5] = sensor->lod;
+
+	rc = hidpp20_request_command(device, &msg);
+	if (rc)
+		return rc;
+
+	return 0;
+}
