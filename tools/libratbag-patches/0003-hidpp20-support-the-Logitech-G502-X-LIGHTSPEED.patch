+static int
+hidpp20drv_read_report_rate_8061(struct ratbag_device *device)
+{
+	struct hidpp20drv_data *drv_data = ratbag_get_drv_data(device);
+	struct ratbag *ratbag = device->ratbag;
+	struct ratbag_profile *profile;
+	uint16_t bitflags;
+	uint8_t rate_index;
+	int nrates = 0;
+	int rc;
+
+	rc = hidpp20_ext_adjustable_report_rate_get_report_rate_list(drv_data->dev,
+								     &bitflags);
+	if (rc < 0)
+		return rc;
+
+	for (rate_index = 0; rate_index < HIDPP20_EXT_REPORT_RATE_COUNT; rate_index++) {
+		if (bitflags & (1 << rate_index))
+			drv_data->report_rates[nrates++] = hidpp20_ext_report_rate_index_to_hz(rate_index);
+	}
+
+	drv_data->num_report_rates = nrates;
+
+	if (!hidpp20_ext_adjustable_report_rate_get_report_rate(drv_data->dev, &rate_index) &&
+	    rate_index < HIDPP20_EXT_REPORT_RATE_COUNT) {
+		unsigned int rate_hz = hidpp20_ext_report_rate_index_to_hz(rate_index);
+
+		log_debug(ratbag, "report rate is %u\n", rate_hz);
+		ratbag_device_for_each_profile(device, profile)
+			profile->hz = rate_hz;
+	}
+
+	log_debug(ratbag, "device has %d report rates\n", nrates);
+
+	return 0;
+}
+
+/**
+ * Onboard profiles (0x8100) store the report rate as a whole number of
+ * milliseconds, so only rates up to 1000Hz can be stored there.
+ */
+static void
+hidpp20drv_set_report_rate_list_8100(struct ratbag_profile *profile,
+				     struct hidpp20drv_data *drv_data)
+{
+	unsigned int rates[ARRAY_LENGTH(drv_data->report_rates)];
+	unsigned int i, nrates = 0;
+
+	for (i = 0; i < drv_data->num_report_rates; i++) {
+		if (drv_data->report_rates[i] <= 1000 &&
+		    1000 % drv_data->report_rates[i] == 0)
+			rates[nrates++] = drv_data->report_rates[i];
+	}
+
+	ratbag_profile_set_report_rate_list(profile, rates, nrates);
+}
