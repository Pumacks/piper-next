+/* 0x8061 - Extended Adjustable Report Rate                                   */
+/* -------------------------------------------------------------------------- */
+
+#define CMD_EXT_ADJUSTABLE_REPORT_RATE_GET_DEVICE_CAPABILITIES	0x00
+#define CMD_EXT_ADJUSTABLE_REPORT_RATE_GET_REPORT_RATE_LIST	0x10
+#define CMD_EXT_ADJUSTABLE_REPORT_RATE_GET_REPORT_RATE		0x20
+#define CMD_EXT_ADJUSTABLE_REPORT_RATE_SET_REPORT_RATE		0x30
+
+/* connection types: 0 wired, 1 LIGHTSPEED. Devices answer the same list
+ * for both, so we try them in order until one is accepted. */
+#define HIDPP20_EXT_REPORT_RATE_CONNECTION_TYPES	2
+
+static int
+hidpp20_ext_adjustable_report_rate_request(struct hidpp20_device *device,
+					   uint8_t command,
+					   union hidpp20_message *msg)
+{
+	uint8_t feature_index;
+	uint8_t connection_type;
+	int rc = -ENOTSUP;
+
+	feature_index = hidpp_root_get_feature_idx(device,
+						   HIDPP_PAGE_EXTENDED_ADJUSTABLE_REPORT_RATE);
+	if (feature_index == 0)
+		return -ENOTSUP;
+
+	for (connection_type = 0;
+	     connection_type < HIDPP20_EXT_REPORT_RATE_CONNECTION_TYPES;
+	     connection_type++) {
+		union hidpp20_message request = {
+			.msg.report_id = REPORT_ID_SHORT,
+			.msg.device_idx = device->index,
+			.msg.sub_id = feature_index,
+			.msg.address = command,
+			.msg.parameters[0] = connection_type,
+		};
+
+		rc = hidpp20_request_command_allow_error(device, &request,
+							 connection_type + 1 < HIDPP20_EXT_REPORT_RATE_CONNECTION_TYPES);
+		if (rc == 0) {
+			*msg = request;
+			return 0;
+		}
+		if (rc < 0)
+			return rc;
+	}
+
+	return rc > 0 ? -EPROTO : rc;
+}
+
+int hidpp20_ext_adjustable_report_rate_get_report_rate_list(struct hidpp20_device *device,
+							    uint16_t *bitflags)
+{
+	union hidpp20_message msg;
+	int rc;
+
+	rc = hidpp20_ext_adjustable_report_rate_request(device,
+							CMD_EXT_ADJUSTABLE_REPORT_RATE_GET_REPORT_RATE_LIST,
+							&msg);
+	if (rc)
+		return rc;
+
+	*bitflags = get_unaligned_be_u16(&msg.msg.parameters[0]);
+
+	return 0;
+}
+
+int hidpp20_ext_adjustable_report_rate_get_report_rate(struct hidpp20_device *device,
+						       uint8_t *rate_index)
+{
+	union hidpp20_message msg;
+	int rc;
+
+	rc = hidpp20_ext_adjustable_report_rate_request(device,
+							CMD_EXT_ADJUSTABLE_REPORT_RATE_GET_REPORT_RATE,
+							&msg);
+	if (rc)
+		return rc;
+
+	*rate_index = msg.msg.parameters[0];
+
+	return 0;
+}
+
+int hidpp20_ext_adjustable_report_rate_set_report_rate(struct hidpp20_device *device,
+						       uint8_t rate_index)
+{
+	uint8_t feature_index;
+	int rc;
+	union hidpp20_message msg = {
+		.msg.report_id = REPORT_ID_SHORT,
+		.msg.device_idx = device->index,
+		.msg.address = CMD_EXT_ADJUSTABLE_REPORT_RATE_SET_REPORT_RATE,
+		.msg.parameters[0] = rate_index,
+	};
+
+	if (rate_index >= HIDPP20_EXT_REPORT_RATE_COUNT)
+		return -EINVAL;
+
+	feature_index = hidpp_root_get_feature_idx(device,
+						   HIDPP_PAGE_EXTENDED_ADJUSTABLE_REPORT_RATE);
+	if (feature_index == 0)
+		return -ENOTSUP;
+
+	msg.msg.sub_id = feature_index;
+
+	rc = hidpp20_request_command(device, &msg);
+	if (rc)
+		return rc;
+
+	return 0;
+}
