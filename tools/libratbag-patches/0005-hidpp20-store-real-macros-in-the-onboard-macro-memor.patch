+/**
+ * Serialize the macros of a profile into that profile's macro sector and
+ * point the button bindings at them. Profile N uses sector
+ * num_profiles + N (the sectors right after the profile sectors), so every
+ * profile has one sector of macro memory.
+ */
+static int
+hidpp20_onboard_profiles_write_macros(struct hidpp20_device *device,
+				      struct hidpp20_profiles *profiles_list,
+				      unsigned int profile_index)
+{
+	struct hidpp20_profile *profile = &profiles_list->profiles[profile_index];
+	_cleanup_free_ uint8_t *data = NULL;
+	uint16_t sector_size = profiles_list->sector_size;
+	uint16_t sector, offset = 0;
+	unsigned int i;
+	bool have_macros = false;
+	int rc;
+
+	for (i = 0; i < profiles_list->num_buttons; i++) {
+		if (profile->buttons[i].any.type == HIDPP20_BUTTON_MACRO &&
+		    profile->macros[i])
+			have_macros = true;
+	}
+	if (!have_macros)
+		return 0;
+
+	sector = profiles_list->num_profiles + 1 + profile_index;
+	if (sector >= profiles_list->sector_count) {
+		hidpp_log_error(&device->base,
+				"no free sector for the macros of profile %u\n",
+				profile_index + 1);
+		return -ENOSPC;
+	}
+
+	data = hidpp20_onboard_profiles_allocate_sector(profiles_list);
+	memset(data, 0xff, sector_size);
+
+	for (i = 0; i < profiles_list->num_buttons; i++) {
+		union hidpp20_macro_data *item;
+		uint16_t start = offset;
+		unsigned int n;
+
+		if (profile->buttons[i].any.type != HIDPP20_BUTTON_MACRO ||
+		    !profile->macros[i])
+			continue;
+
+		for (n = 0, item = profile->macros[i]; ; n++, item++) {
+			union hidpp20_macro_data out = *item;
+			int size = hidpp20_macro_item_size(item->any.type);
+
+			if (n >= HIDPP20_MACRO_MAX_ITEMS) {
+				hidpp_log_error(&device->base,
+						"macro of button %u is not terminated\n", i);
+				return -EINVAL;
+			}
+			if (size < 0 || item->any.type == HIDPP20_MACRO_JUMP) {
+				hidpp_log_error(&device->base,
+						"cannot write macro command 0x%02x\n",
+						item->any.type);
+				return -EINVAL;
+			}
+			/* keep the last two bytes for the CRC */
+			if (offset + size > sector_size - 2) {
+				hidpp_log_error(&device->base,
+						"the macros of profile %u do not fit into one sector\n",
+						profile_index + 1);
+				return -ENOSPC;
+			}
+			if (item->any.type == HIDPP20_MACRO_DELAY)
+				out.delay.time = hidpp_cpu_to_be_u16(item->delay.time);
+
+			memcpy(&data[offset], &out, size);
+			offset += size;
+
+			if (item->any.type == HIDPP20_MACRO_END)
+				break;
+		}
+
+		/* the binding stores the sector in the 'zero' field until
+		 * hidpp20_buttons_from_cpu() swaps it into place */
+		profile->buttons[i].macro.zero = sector;
+		profile->buttons[i].macro.offset = start;
+	}
+
+	hidpp_log_debug(&device->base,
+			"writing %u bytes of macros for profile %u to sector 0x%04x\n",
+			offset, profile_index + 1, sector);
+
+	rc = hidpp20_onboard_profiles_write_sector(device, sector, sector_size, data, true);
+	if (rc < 0)
+		hidpp_log_error(&device->base, "failed to write macros\n");
+
+	return rc;
+}
