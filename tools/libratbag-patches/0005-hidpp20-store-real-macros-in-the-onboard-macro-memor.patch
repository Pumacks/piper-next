 			   struct hidpp20_profile *profile,
@@ -188,6 +301,21 @@ hidpp20drv_read_macro_8100(struct ratbag_button *button,
 						      keycode);
 			delay = false;
 			break;
+		case HIDPP20_MACRO_WAIT_FOR_RELEASE:
+			ratbag_button_macro_set_event(m, i++,
+						      RATBAG_MACRO_EVENT_WAIT_FOR_RELEASE, 0);
+			delay = true;
+			break;
+		case HIDPP20_MACRO_REPEAT_WHILE_PRESSED:
+			ratbag_button_macro_set_event(m, i++,
+						      RATBAG_MACRO_EVENT_REPEAT_WHILE_PRESSED, 0);
+			delay = true;
+			break;
+		case HIDPP20_MACRO_REPEAT_UNTIL_CANCELED:
+			ratbag_button_macro_set_event(m, i++,
+						      RATBAG_MACRO_EVENT_REPEAT_UNTIL_CANCELED, 0);
+			delay = true;
+			break;
 		}
 		macro++;
 	}
@@ -548,17 +676,24 @@ hidpp20drv_update_button_8100(struct ratbag_button *button)
 		profile->buttons[button->index].button.buttons = action->action.button;
 		break;
 	case RATBAG_BUTTON_ACTION_TYPE_MACRO:
-		type = HIDPP20_BUTTON_HID_TYPE;
-		subtype = HIDPP20_BUTTON_HID_TYPE_KEYBOARD;
 		rc = ratbag_action_keycode_from_macro(action,
 						      &key,
 						      &modifiers);
-		if (rc < 0) {
-			log_error(device->ratbag,
-				  "Error while writing macro for button %d\n",
-				  button->index);
+		if (rc != 1) {
+			/* not a plain key with modifiers: store it in the
+			 * onboard macro memory */
+			rc = hidpp20drv_write_macro_8100(button, profile);
+			if (rc < 0) {
+				log_error(device->ratbag,
+					  "Error while writing macro for button %d (%d)\n",
+					  button->index, rc);
+				return rc;
+			}
+			break;
 		}
 
+		type = HIDPP20_BUTTON_HID_TYPE;
+		subtype = HIDPP20_BUTTON_HID_TYPE_KEYBOARD;
 		code = ratbag_hidraw_get_keyboard_usage_from_keycode(device, key);
 		if (code == 0) {
 			subtype = HIDPP20_BUTTON_HID_TYPE_CONSUMER_CONTROL;
