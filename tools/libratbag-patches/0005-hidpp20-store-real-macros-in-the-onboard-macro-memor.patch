+static uint8_t
+hidpp20drv_macro_modifier_mask_8100(unsigned int keycode)
+{
+	switch (keycode) {
+	case KEY_LEFTCTRL: return 0x01;
+	case KEY_LEFTSHIFT: return 0x02;
+	case KEY_LEFTALT: return 0x04;
+	case KEY_LEFTMETA: return 0x08;
+	case KEY_RIGHTCTRL: return 0x10;
+	case KEY_RIGHTSHIFT: return 0x20;
+	case KEY_RIGHTALT: return 0x40;
+	case KEY_RIGHTMETA: return 0x80;
+	}
+
+	return 0;
+}
+
+/**
+ * Convert the button's ratbag macro into onboard macro commands. The
+ * commands are stored in the profile and written to the device's macro
+ * memory on commit.
+ */
+static int
+hidpp20drv_write_macro_8100(struct ratbag_button *button,
+			    struct hidpp20_profile *profile)
+{
+	struct ratbag_device *device = button->profile->device;
+	const struct ratbag_macro *macro = button->action.macro;
+	union hidpp20_macro_data *items;
+	unsigned int i, n = 0;
+
+	if (!macro)
+		return -EINVAL;
+
+	/* one command per event plus the terminating END */
+	items = zalloc((MAX_MACRO_EVENTS + 1) * sizeof(*items));
+
+	for (i = 0; i < MAX_MACRO_EVENTS; i++) {
+		const struct ratbag_macro_event *event = &macro->events[i];
+		union hidpp20_macro_data *item = &items[n];
+		bool press;
+		uint8_t modifier, usage;
+		uint16_t consumer;
+
+		if (event->type == RATBAG_MACRO_EVENT_NONE)
+			break;
+
+		switch (event->type) {
+		case RATBAG_MACRO_EVENT_KEY_PRESSED:
+		case RATBAG_MACRO_EVENT_KEY_RELEASED:
+			press = event->type == RATBAG_MACRO_EVENT_KEY_PRESSED;
+			modifier = hidpp20drv_macro_modifier_mask_8100(event->event.key);
+			if (modifier) {
+				item->key.type = press ? HIDPP20_MACRO_KEY_PRESS : HIDPP20_MACRO_KEY_RELEASE;
+				item->key.modifier = modifier;
+				break;
+			}
+			usage = ratbag_hidraw_get_keyboard_usage_from_keycode(device, event->event.key);
+			if (usage) {
+				item->key.type = press ? HIDPP20_MACRO_KEY_PRESS : HIDPP20_MACRO_KEY_RELEASE;
+				item->key.key = usage;
+				break;
+			}
+			consumer = ratbag_hidraw_get_consumer_usage_from_keycode(device, event->event.key);
+			if (!consumer) {
+				log_error(device->ratbag,
+					  "hidpp20: key %u cannot be stored in a macro\n",
+					  event->event.key);
+				goto err;
+			}
+			item->consumer.type = press ? HIDPP20_MACRO_CONS_DOWN : HIDPP20_MACRO_CONS_UP;
+			item->consumer.usage = hidpp_cpu_to_be_u16(consumer);
+			break;
+		case RATBAG_MACRO_EVENT_WAIT:
+			item->delay.type = HIDPP20_MACRO_DELAY;
+			item->delay.time = min(event->event.timeout, 0xffffu);
+			break;
+		case RATBAG_MACRO_EVENT_WAIT_FOR_RELEASE:
+			item->any.type = HIDPP20_MACRO_WAIT_FOR_RELEASE;
+			break;
+		case RATBAG_MACRO_EVENT_REPEAT_WHILE_PRESSED:
+			item->any.type = HIDPP20_MACRO_REPEAT_WHILE_PRESSED;
+			break;
+		case RATBAG_MACRO_EVENT_REPEAT_UNTIL_CANCELED:
+			item->any.type = HIDPP20_MACRO_REPEAT_UNTIL_CANCELED;
+			break;
+		default:
+			goto err;
+		}
+		n++;
+	}
+
+	if (n == 0)
+		goto err;
+
+	items[n].any.type = HIDPP20_MACRO_END;
+
+	free(profile->macros[button->index]);
+	profile->macros[button->index] = items;
+
+	/* the sector and offset are assigned when the macros are written */
+	profile->buttons[button->index].macro.type = HIDPP20_BUTTON_MACRO;
+	profile->buttons[button->index].macro.page = button->index;
+	profile->buttons[button->index].macro.zero = 0;
+	profile->buttons[button->index].macro.offset = 0;
+
+	return 0;
+
+err:
+	free(items);
+	return -EINVAL;
+}
